# ===========================================
# ENVIRONMENT: local | dev | production
#   local      = SQLite database (no AWS needed, works offline)
#   dev        = DynamoDB tables prefixed with "Shichida-dev-"
#   production = DynamoDB tables prefixed with "Shichida-production-"
# ===========================================
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here

# ===========================================
# AWS Credentials (required for dev/production)
# ===========================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1

# ===========================================
# CORS & Hosts
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Email (AWS SES) — required for dev/production
# Sender must be a verified SES identity (or verified domain).
# Accepts "Name <email>" form.
#
# NOTE: while the SES account is in the sandbox, EVERY recipient must also be
# a verified identity — unverified recipients are rejected with MessageRejected.
# ===========================================
AWS_SES_SENDER=Shichida India Portal <noreply-test@shichidain.com>
